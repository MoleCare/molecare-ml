# MoleCare-ML environment. Copy to .env and edit:
#
#     cp .env.example .env
#
# .env is gitignored; this file is not. Placeholders only — never put a real
# token, key, hostname or patient data here.

# --- serving ----------------------------------------------------------------

# Path to the TensorFlow SavedModel. Fetch the weights first with
# scripts/fetch-model.sh; they are not in the repository.
MODEL_PATH=./cnn-models/xception/1

# HTTP port.
PORT=5000

# Bind address for local runs. Leave as localhost unless you mean to expose it.
FLASK_HOST=127.0.0.1

# 1 enables the Werkzeug debugger, which permits arbitrary code execution.
# Never set this in production.
FLASK_DEBUG=0

# Comma-separated origin allowlist. Defaults to localhost only. Set the real
# origins in production, and do not use *.
CORS_ALLOWED_ORIGINS=http://localhost:3030,http://localhost:3000

# Maximum request body size in megabytes. Oversized requests get a JSON 413.
MAX_UPLOAD_MB=10

# --- optional ---------------------------------------------------------------

# Hugging Face token, only for the Derm Foundation path, which is legacy and
# not wired up. See "Derm Foundation, and what replaces it" in the README.
HUGGINGFACE_TOKEN=

# Weights & Biases, only for training runs.
WANDB_API_KEY=
WANDB_ENTITY=

# AWS credentials are deliberately absent. Deployed instances use an IAM
# instance profile, and local work should use a named profile in ~/.aws.
# Never commit an access key.
AWS_REGION=eu-west-2
